# Never commit a real Project Brain into the skill repo.
# A real brain contains your infra details — DB names, ports, server paths, hostnames.
.project-brain/

# ...except the synthetic example shipped with the skill (acme-*).
!examples/**/.project-brain/
!examples/**/.project-brain/**

# Local cruft
__pycache__/
.DS_Store
*.local
*.log

# Never commit a generated context export — it can carry infra. Regenerate on demand.
# Listed last so it overrides the examples re-include above (last matching pattern wins).
context-export.md
